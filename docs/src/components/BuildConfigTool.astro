---
import { Tabs, TabItem } from "@astrojs/starlight/components";
import { fetchRemoteBuildData } from "../utils/qbtVersions";
import {
	buildConfigOptions,
	DOCKER_VAR_NAMES,
} from "../data/buildConfigOptions";

const { versions, overrides } = await fetchRemoteBuildData();
const configOptions = buildConfigOptions(versions, overrides);
const basicOptions = configOptions.filter((o) => o.category === "basic");
const advancedOptions = configOptions.filter((o) => o.category === "advanced");
const instanceId = `bct_${Math.random().toString(36).slice(2, 8)}`;

const ltSeriesDefaults = {
	"2.1": versions.libtorrent_2_1,
	"2.0": versions.libtorrent_2_0,
	"1.2": versions.libtorrent_1_2,
};
const qtSeriesDefaults = {
	"6": versions.qt6,
	"5": versions.qt5,
};
---

<style>
	.build-config {
		border: 1px solid var(--code-inline-border);
		border-radius: 0.5rem;
		padding: 1.25rem;
		margin: 1rem 0;
		background: var(--details-1);
		box-shadow: var(--shadow-md);
	}

	.config-header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 1rem;
		padding-bottom: 0.875rem;
		border-bottom: 1px solid var(--code-inline-border);
	}

	.header-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
	}

	.view-toggle {
		display: flex;
		align-items: center;
	}

	.view-toggle .switch {
		position: relative;
		display: inline-block;
		min-width: 12rem;
		height: 2.25rem;
		cursor: pointer;
	}

	.view-toggle .switch input {
		opacity: 0;
		width: 0;
		height: 0;
		position: absolute;
	}

	.view-toggle .slider {
		position: absolute;
		inset: 0;
		border-radius: 4px;
		background: var(--code-inline-background);
		border: 1px solid var(--code-inline-border);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		font-weight: 500;
	}

	.view-toggle .slider .label {
		text-align: center;
		user-select: none;
		position: relative;
		z-index: 2;
		color: var(--code-inline-color);
		transition: var(--transition-fast);
		padding: 0 0.75rem;
		white-space: nowrap;
	}

	.view-toggle .slider::before {
		content: "";
		position: absolute;
		top: 3px;
		left: 3px;
		width: calc(50% - 6px);
		height: calc(100% - 6px);
		border-radius: 3px;
		background: var(--sl-button-bg-primary);
		border: 1px solid var(--code-inline-border);
		transition: var(--transition-normal);
		z-index: 1;
	}

	.view-toggle .switch input:checked + .slider::before {
		left: calc(50% + 3px);
	}

	/* High-contrast active vs inactive labels in both dark & light themes */
	.view-toggle .switch input:not(:checked) + .slider .label-off,
	.view-toggle .switch input:checked + .slider .label-on {
		color: #0b241d;
		font-weight: 600;
	}

	.view-toggle .switch input:not(:checked) + .slider .label-on,
	.view-toggle .switch input:checked + .slider .label-off {
		opacity: 0.78;
	}

	.view-toggle .switch input:focus-visible + .slider {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.modified-summary {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		height: 2.25rem;
		padding: 0 0.65rem;
		border-radius: 4px;
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		background: var(--code-inline-background);
		border: 1px solid var(--code-inline-border);
		color: var(--code-inline-color);
		box-sizing: border-box;
		white-space: nowrap;
	}

	.modified-summary[data-has-changes="true"] {
		border-color: rgba(245, 158, 11, 0.7);
	}

	:global([data-theme="light"]) .modified-summary[data-has-changes="true"] {
		border-color: #d97706;
	}

	.reset-button {
		padding: 0 0.9rem;
		background: var(--code-inline-background);
		color: var(--code-inline-color);
		border: 1px solid var(--code-inline-border);
		border-radius: 4px;
		cursor: pointer;
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		font-weight: 500;
		height: 2.25rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		transition: var(--transition-fast);
	}

	.reset-button:hover {
		background: var(--sl-button-bg-primary);
		color: #0b241d;
		box-shadow: var(--shadow-sm);
	}

	.reset-button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.config-section {
		margin-bottom: 1rem;
	}

	.config-options {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
	}

	.config-option {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(220px, 280px);
		align-items: start;
		gap: 0.75rem 1.25rem;
		padding: 0.85rem 1rem;
		background: var(--sl-color-bg);
		border: 1px solid var(--code-inline-border);
		border-radius: 8px;
		transition: var(--transition-fast);
	}

	.config-option:hover {
		border-color: var(--sl-color-accent);
		box-shadow: var(--shadow-sm);
	}

	.option-meta {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}

	.option-heading {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem;
	}

	.option-label {
		margin: 0;
		font-size: 0.925rem;
		color: var(--sl-color-accent-high);
		font-weight: 600;
		line-height: 1.3;
		cursor: pointer;
	}

	.option-var-badge,
	.status-indicator {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.15rem 0.5rem;
		border-radius: 4px;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1.35;
		background: var(--code-inline-background);
		border: 1px solid var(--code-inline-border);
		color: var(--code-inline-color);
		white-space: nowrap;
		box-sizing: border-box;
	}

	.status-indicator[data-modified="true"] {
		border-color: rgba(245, 158, 11, 0.7);
	}

	:global([data-theme="light"]) .status-indicator[data-modified="true"] {
		border-color: #d97706;
	}

	.status-led {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		flex-shrink: 0;
		background-color: #10b981;
		box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.22);
		transition: var(--transition-fast);
	}

	.status-led.modified {
		background-color: #f59e0b;
		box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.25);
	}

	.option-explanation {
		margin: 0;
		color: var(--sl-color-text);
		opacity: 0.88;
		font-size: 0.82rem;
		line-height: 1.45;
	}

	.option-control {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		width: 100%;
	}

	.option-control select {
		width: 100%;
		height: 2.4rem;
		padding: 0.45rem 0.7rem;
		border: 1px solid var(--code-inline-border);
		border-radius: 6px;
		background: var(--details-1);
		color: var(--sl-color-text);
		font: inherit;
		font-size: 0.85rem;
		font-weight: 500;
		cursor: pointer;
		transition: var(--transition-fast);
		box-sizing: border-box;
	}

	.option-control select:hover:not(:disabled) {
		border-color: var(--sl-color-accent);
	}

	.option-control select:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.option-control select:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}

	.custom-input {
		width: 100%;
		height: 2.25rem;
		padding: 0.4rem 0.65rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 6px;
		background: var(--details-1);
		color: var(--sl-color-text);
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		box-sizing: border-box;
	}

	.custom-input:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 1px;
	}

	.custom-input::placeholder {
		color: var(--sl-color-gray-3);
		opacity: 0.8;
	}

	.advanced-section {
		display: none;
	}

	.build-config[data-view="advanced"] .advanced-section {
		display: block;
	}

	.build-config[data-docker-tab="false"]
		.config-option[data-docker-only="true"] {
		display: none;
	}

	.build-config[data-dockerfile-tab="true"]
		.config-option[data-docker-volume="true"] {
		display: none;
	}

	.output-section {
		margin-top: 1.5rem;
		padding-top: 1rem;
		border-top: 1px solid var(--code-inline-border);
	}

	.command-output-card {
		margin: 0.75rem 0 0;
		border-radius: 0.5rem;
		overflow: hidden;
		border: 1px solid var(--code-inline-border);
		background-color: var(--code-inline-background);
		box-shadow: var(--shadow-md);
	}

	.output-toolbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.45rem 0.75rem;
		background: var(--sl-color-bg);
		border-bottom: 1px solid var(--code-inline-border);
	}

	.output-kind-label {
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--sl-color-text);
		opacity: 0.85;
	}

	.output-actions {
		display: flex;
		gap: 0.4rem;
	}

	.action-button {
		padding: 0.25rem 0.65rem;
		background: var(--details-1);
		color: var(--sl-color-text);
		border: 1px solid var(--code-inline-border);
		border-radius: 0.375rem;
		font: inherit;
		font-size: 0.78rem;
		font-weight: 600;
		cursor: pointer;
		transition: var(--transition-fast);
	}

	.action-button:hover {
		background: var(--sl-button-bg-primary);
		color: #0b241d;
		box-shadow: var(--shadow-sm);
	}

	.action-button:active {
		transform: scale(0.96);
	}

	.action-button:focus-visible {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: 2px;
	}

	.command-output-card pre {
		margin: 0;
		padding: 1rem;
		overflow-x: auto;
		background: transparent;
		border: none;
		font-family: var(--sl-font-mono);
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--code-inline-color);
		white-space: pre;
	}

	.command-output-card pre code {
		display: block;
		background: none;
		padding: 0;
		border: none;
		font-family: inherit;
		font-size: inherit;
		line-height: inherit;
		color: inherit;
		white-space: pre;
	}

	/* Theme-aware syntax tokens */
	.command-output-card :global(.tok-comment) {
		color: #9ca3af;
		font-style: italic;
	}

	.command-output-card :global(.tok-var) {
		color: #e0af68;
	}

	.command-output-card :global(.tok-string) {
		color: #9ece6a;
	}

	.command-output-card :global(.tok-keyword),
	.command-output-card :global(.tok-cmd) {
		color: #7aa2f7;
		font-weight: 600;
	}

	.command-output-card :global(.tok-flag) {
		color: #bb9af7;
	}

	.command-output-card :global(.tok-punct) {
		color: var(--sl-color-gray-2);
	}

	:global([data-theme="light"]) .command-output-card :global(.tok-comment) {
		color: #4b5563;
	}

	:global([data-theme="light"]) .command-output-card :global(.tok-var) {
		color: #9a5b00;
	}

	:global([data-theme="light"]) .command-output-card :global(.tok-string) {
		color: #166534;
	}

	:global([data-theme="light"]) .command-output-card :global(.tok-keyword),
	:global([data-theme="light"]) .command-output-card :global(.tok-cmd) {
		color: #1d4ed8;
	}

	:global([data-theme="light"]) .command-output-card :global(.tok-flag) {
		color: #7e22ce;
	}

	@media (max-width: 768px) {
		.build-config {
			margin: 0.5rem 0;
			padding: 0.85rem;
		}

		.config-header {
			flex-direction: column;
			align-items: stretch;
		}

		.header-controls {
			justify-content: space-between;
		}

		.config-option {
			grid-template-columns: 1fr;
			gap: 0.65rem;
			padding: 0.75rem;
		}

		.view-toggle .switch {
			min-width: 10.5rem;
		}

		.command-output-card pre {
			padding: 0.75rem;
			font-size: 0.8rem;
		}
	}
</style>

<div
	class="build-config not-content"
	data-build-config
	data-instance-id={instanceId}
	data-view="basic"
	data-docker-tab="false"
	data-dockerfile-tab="false"
	data-lt-defaults={JSON.stringify(ltSeriesDefaults)}
	data-qt-defaults={JSON.stringify(qtSeriesDefaults)}
>
	<div class="config-header">
		<div class="header-controls">
			<div class="view-toggle">
				<label class="switch">
					<input
						id={`${instanceId}_view_toggle`}
						data-role="view-toggle"
						type="checkbox"
						role="switch"
						aria-label="Toggle expert settings"
					/>
					<span class="slider">
						<span class="label label-off">Basic</span>
						<span class="label label-on">Expert</span>
					</span>
				</label>
			</div>
			<span
				class="modified-summary"
				data-role="modified-summary"
				aria-live="polite"
				data-has-changes="false"
			>
				<span
					class="status-led"
					data-role="summary-led"
					aria-hidden="true"
				/>
				<span data-role="summary-text">0 modified</span>
			</span>
		</div>
		<button type="button" class="reset-button" data-role="reset-button">
			Reset
		</button>
	</div>

	{
		[
			{ options: basicOptions, cls: "config-section" },
			{ options: advancedOptions, cls: "config-section advanced-section" },
		].map(({ options, cls }) => (
			<div class={cls}>
				<div class="config-options">
					{options.map((option) => (
						<div
							class="config-option"
							data-category={option.category}
							data-docker-only={
								DOCKER_VAR_NAMES.has(option.variable) ? "true" : undefined
							}
							data-docker-volume={
								option.variable === "qbt_docker_volume" ? "true" : undefined
							}
						>
							<div class="option-meta">
								<div class="option-heading">
									<label
										class="option-label"
										for={`${instanceId}_config_${option.variable}`}
									>
										{option.label}
									</label>
									<code class="option-var-badge">{option.variable}</code>
									<span
										class="status-indicator"
										data-indicator-for={option.variable}
										data-modified="false"
									>
										<span
											class="status-led"
											data-led-for={option.variable}
											aria-hidden="true"
										/>
										<span data-status-for={option.variable}>Default</span>
									</span>
								</div>
								<p
									class="option-explanation"
									id={`${instanceId}_desc_${option.variable}`}
								>
									{option.description}
								</p>
							</div>
							<div class="option-control">
								<select
									id={`${instanceId}_config_${option.variable}`}
									data-variable={option.variable}
									data-default={option.defaultVal}
									data-default-example={option.defaultExample ?? option.defaultVal}
									aria-describedby={`${instanceId}_desc_${option.variable}`}
								>
									{option.options.map((opt) => (
										<option
											value={opt.value}
											data-override={opt.isOverride ? "true" : undefined}
											selected={opt.value === option.defaultVal}
										>
											{opt.label}
										</option>
									))}
								</select>
								{option.allowCustom && (
									<input
										class="custom-input"
										type="text"
										placeholder={`Enter custom ${option.label.toLowerCase()}`}
										aria-label={`Custom ${option.label}`}
										data-custom-for={option.variable}
										hidden
									/>
								)}
							</div>
						</div>
					))}
				</div>
			</div>
		))
	}

	<div class="output-section" data-role="output-section">
		<Tabs syncKey="command-type">
			<TabItem label="Native (Remote)" icon="rocket">
				<div class="command-output-card">
					<div class="output-toolbar">
						<span class="output-kind-label">bash — remote script</span>
						<div class="output-actions">
							<button type="button" class="action-button copy-button" data-output="native">
								Copy
							</button>
						</div>
					</div>
					<pre><code data-output-target="native" data-lang="bash" /></pre>
				</div>
			</TabItem>
			<TabItem label="Native (Local)" icon="document">
				<div class="command-output-card">
					<div class="output-toolbar">
						<span class="output-kind-label">bash — download &amp; run locally</span>
						<div class="output-actions">
							<button type="button" class="action-button copy-button" data-output="local">
								Copy
							</button>
						</div>
					</div>
					<pre><code data-output-target="local" data-lang="bash" /></pre>
				</div>
			</TabItem>
			<TabItem label="Docker (Remote)" icon="external">
				<div class="command-output-card">
					<div class="output-toolbar">
						<span class="output-kind-label">docker run — remote script</span>
						<div class="output-actions">
							<button type="button" class="action-button copy-button" data-output="docker">
								Copy
							</button>
						</div>
					</div>
					<pre><code data-output-target="docker" data-lang="bash" /></pre>
				</div>
			</TabItem>
			<TabItem label="Docker (Local)" icon="laptop">
				<div class="command-output-card">
					<div class="output-toolbar">
						<span class="output-kind-label">docker run — local script in volume</span>
						<div class="output-actions">
							<button
								type="button"
								class="action-button copy-button"
								data-output="docker-local"
							>
								Copy
							</button>
						</div>
					</div>
					<pre><code data-output-target="docker-local" data-lang="bash" /></pre>
				</div>
			</TabItem>
			<TabItem label="Dockerfile" icon="seti:docker">
				<div class="command-output-card">
					<div class="output-toolbar">
						<span class="output-kind-label">Dockerfile</span>
						<div class="output-actions">
							<button
								type="button"
								class="action-button download-button"
								data-output="dockerfile"
								data-filename="Dockerfile"
							>
								Download
							</button>
							<button
								type="button"
								class="action-button copy-button"
								data-output="dockerfile"
							>
								Copy
							</button>
						</div>
					</div>
					<pre><code data-output-target="dockerfile" data-lang="docker" /></pre>
				</div>
			</TabItem>
			<TabItem label=".qbt_env" icon="setting">
				<div class="command-output-card">
					<div class="output-toolbar">
						<span class="output-kind-label">.qbt_env — place beside qbt.bash</span>
						<div class="output-actions">
							<button
								type="button"
								class="action-button download-button"
								data-output="qbt-env"
								data-filename=".qbt_env"
							>
								Download
							</button>
							<button
								type="button"
								class="action-button copy-button"
								data-output="qbt-env"
							>
								Copy
							</button>
						</div>
					</div>
					<pre><code data-output-target="qbt-env" data-lang="dotenv" /></pre>
				</div>
			</TabItem>
		</Tabs>
	</div>
</div>

<script>
	import {
		generateAllOutputs,
		isOptionModified,
		type BuildConfigState,
	} from "../utils/buildCommandGenerator";
	import { highlightCode, type HighlightLang } from "../utils/codeHighlight";

	type TabContext = "native" | "docker" | "dockerfile";
	type PortVolumeSnapshot = {
		port: string;
		customPort: string;
		volume: string;
		customVolume: string;
	};

	const VIEW_STORAGE_KEY = "buildconfig-view";

	function readStorage(key: string): string | null {
		try {
			return window.localStorage.getItem(key);
		} catch {
			return null;
		}
	}

	function writeStorage(key: string, value: string): void {
		try {
			window.localStorage.setItem(key, value);
		} catch {
			// Ignore storage failures in restricted contexts
		}
	}

	function initBuildConfigInstance(container: HTMLElement): void {
		if (container.dataset.initialized === "true") return;
		container.dataset.initialized = "true";

		const ltDefaults: Record<string, string> = JSON.parse(
			container.dataset.ltDefaults ?? "{}",
		);
		const qtDefaults: Record<string, string> = JSON.parse(
			container.dataset.qtDefaults ?? "{}",
		);

		const viewToggle = container.querySelector<HTMLInputElement>(
			'[data-role="view-toggle"]',
		);
		const resetButton = container.querySelector<HTMLButtonElement>(
			'[data-role="reset-button"]',
		);
		const modifiedSummary = container.querySelector<HTMLElement>(
			'[data-role="modified-summary"]',
		);
		const summaryLed = container.querySelector<HTMLElement>(
			'[data-role="summary-led"]',
		);
		const summaryText = container.querySelector<HTMLElement>(
			'[data-role="summary-text"]',
		);
		const outputSection = container.querySelector<HTMLElement>(
			'[data-role="output-section"]',
		);
		const selects = Array.from(
			container.querySelectorAll<HTMLSelectElement>("select[data-variable]"),
		);

		const selectByVar = new Map<string, HTMLSelectElement>();
		for (const select of selects) {
			const v = select.dataset.variable;
			if (v) selectByVar.set(v, select);
		}

		const portSelect = selectByVar.get("qbt_docker_port") ?? null;
		const originalPortOptionsHTML = portSelect?.innerHTML ?? "";
		const originalPortDefault = portSelect?.dataset.default ?? "8080:8080";
		const originalPortExample =
			portSelect?.dataset.defaultExample ?? "8080:8080";
		const portLabelEl =
			portSelect
				?.closest(".config-option")
				?.querySelector<HTMLElement>(".option-label") ?? null;
		const originalPortLabel =
			portLabelEl?.textContent ?? "Docker Port Mapping";

		let activePortContext: "docker" | "dockerfile" = "docker";
		const savedDockerContext: Record<
			"docker" | "dockerfile",
			PortVolumeSnapshot
		> = {
			docker: { port: "", customPort: "", volume: "", customVolume: "" },
			dockerfile: { port: "", customPort: "", volume: "", customVolume: "" },
		};

		let latestOutputs: Record<string, string> = {};
		const copyTimers = new WeakMap<HTMLButtonElement, number>();

		function getCustomInput(variable: string): HTMLInputElement | null {
			return container.querySelector<HTMLInputElement>(
				`input[data-custom-for="${CSS.escape(variable)}"]`,
			);
		}

		function getSelectValue(select: HTMLSelectElement): string {
			if (select.value !== "custom") return select.value;
			const v = select.dataset.variable;
			if (!v) return "";
			return getCustomInput(v)?.value.trim() ?? "";
		}

		function syncCustomInputUI(
			select: HTMLSelectElement,
			{ focus = false }: { focus?: boolean } = {},
		): void {
			const variable = select.dataset.variable;
			if (!variable) return;
			const customInput = getCustomInput(variable);
			if (!customInput) return;

			const isCustom = select.value === "custom";
			customInput.hidden = !isCustom;

			if (isCustom) {
				if (!customInput.value.trim()) {
					customInput.value =
						select.dataset.defaultExample ?? select.dataset.default ?? "";
				}
				if (focus) {
					customInput.focus();
					customInput.select();
				}
			} else {
				customInput.value = "";
			}
		}

		function selectSeriesDefault(
			select: HTMLSelectElement,
			prefix: string,
			autoLabel: string,
			exampleTag: string,
		): void {
			select.dataset.defaultExample = exampleTag;
			const defaultOpt = Array.from(select.options).find(
				(opt) => opt.value === "default",
			);
			if (defaultOpt) {
				defaultOpt.textContent = autoLabel;
				defaultOpt.label = autoLabel;
			}

			const overrideOpt = Array.from(select.options).find(
				(opt) =>
					opt.dataset.override === "true" && opt.value.startsWith(prefix),
			);
			select.value = overrideOpt ? overrideOpt.value : "default";
			syncCustomInputUI(select);
		}

		function syncLibtorrentSeries(series: string): void {
			const tagSel = selectByVar.get("qbt_libtorrent_tag");
			if (!tagSel) return;
			const resolvedVer = ltDefaults[series] ?? ltDefaults["2.1"] ?? "2.1.2";
			const label =
				series === "2.1"
					? `Auto — latest for series (v${resolvedVer})`
					: `Auto — latest for ${series} (v${resolvedVer})`;
			selectSeriesDefault(tagSel, `v${series}.`, label, `v${resolvedVer}`);
		}

		function syncQtSeries(series: string): void {
			const tagSel = selectByVar.get("qbt_qt_tag");
			if (!tagSel) return;
			const resolvedVer = qtDefaults[series] ?? qtDefaults["6"] ?? "6.12.0";
			const label =
				series === "6"
					? `Auto — latest for Qt version (v${resolvedVer})`
					: `Auto — latest for Qt ${series} (v${resolvedVer})`;
			selectSeriesDefault(tagSel, `v${series}.`, label, `v${resolvedVer}`);
		}

		function readState(): BuildConfigState {
			const values: Record<string, string> = {};
			const defaults: Record<string, string> = {};
			const overrides = new Set<string>();

			for (const select of selects) {
				const v = select.dataset.variable;
				if (!v) continue;
				values[v] = getSelectValue(select);
				defaults[v] = select.dataset.default ?? "";
				const selectedOpt = select.options[select.selectedIndex];
				if (selectedOpt?.dataset.override === "true") {
					overrides.add(v);
				}
			}

			return { values, defaults, overrides };
		}

		function updateOutputs(): void {
			const state = readState();
			const generated = generateAllOutputs(state);
			latestOutputs = {
				native: generated.native,
				local: generated.local,
				docker: generated.docker,
				"docker-local": generated.dockerLocal,
				dockerfile: generated.dockerfile,
				"qbt-env": generated.qbtEnv,
			};

			for (const [key, text] of Object.entries(latestOutputs)) {
				const codeEl = container.querySelector<HTMLElement>(
					`code[data-output-target="${CSS.escape(key)}"]`,
				);
				if (!codeEl) continue;
				const lang =
					(codeEl.dataset.lang as HighlightLang | undefined) ?? "bash";
				codeEl.innerHTML = highlightCode(text, lang);
			}
		}

		function updateStatusIndicators(): void {
			let modifiedCount = 0;
			let hiddenExpertCount = 0;
			let hiddenDockerCount = 0;
			const isBasicView = container.dataset.view !== "advanced";
			const isDockerTab = container.dataset.dockerTab === "true";

			for (const select of selects) {
				const variable = select.dataset.variable;
				const def = select.dataset.default;
				if (!variable || def === undefined) continue;

				const selectedOpt = select.options[select.selectedIndex];
				const isOverride = selectedOpt?.dataset.override === "true";
				const modified = isOptionModified(
					getSelectValue(select),
					def,
					isOverride,
				);
				if (modified) {
					modifiedCount++;
					const optionRow = select.closest<HTMLElement>(".config-option");
					const isDockerOnly = optionRow?.dataset.dockerOnly === "true";
					const isAdvanced = optionRow?.dataset.category === "advanced";
					if (isDockerOnly && !isDockerTab) {
						hiddenDockerCount++;
					} else if (isAdvanced && isBasicView) {
						hiddenExpertCount++;
					}
				}

				const indicator = container.querySelector<HTMLElement>(
					`[data-indicator-for="${CSS.escape(variable)}"]`,
				);
				const led = container.querySelector<HTMLElement>(
					`[data-led-for="${CSS.escape(variable)}"]`,
				);
				const label = container.querySelector<HTMLElement>(
					`[data-status-for="${CSS.escape(variable)}"]`,
				);
				if (indicator) {
					indicator.dataset.modified = modified ? "true" : "false";
				}
				led?.classList.toggle("modified", modified);
				if (label) label.textContent = modified ? "Modified" : "Default";
			}

			if (modifiedSummary) {
				const baseText =
					modifiedCount === 1 ? "1 modified" : `${modifiedCount} modified`;
				const hiddenParts: string[] = [];
				if (hiddenExpertCount > 0) hiddenParts.push(`${hiddenExpertCount} in Expert`);
				if (hiddenDockerCount > 0) hiddenParts.push(`${hiddenDockerCount} in Docker`);
				const labelText = hiddenParts.length
					? `${baseText} (${hiddenParts.join(", ")})`
					: baseText;
				if (summaryText) {
					summaryText.textContent = labelText;
				} else {
					modifiedSummary.textContent = labelText;
				}
				summaryLed?.classList.toggle("modified", modifiedCount > 0);
				modifiedSummary.dataset.hasChanges = modifiedCount > 0 ? "true" : "false";
			}
		}

		function syncTagSeriesFromValue(variable: string, cur: string): void {
			if (variable === "qbt_libtorrent_tag") {
				const verSel = selectByVar.get("qbt_libtorrent_version");
				if (!verSel) return;
				if (cur.startsWith("v2.1") || cur.startsWith("RC_2_1")) {
					verSel.value = "2.1";
				} else if (cur.startsWith("v2.0") || cur.startsWith("RC_2_0")) {
					verSel.value = "2.0";
				} else if (cur.startsWith("v1.2") || cur.startsWith("RC_1_2")) {
					verSel.value = "1.2";
				}
			}

			if (variable === "qbt_qt_tag") {
				const verSel = selectByVar.get("qbt_qt_version");
				const toolSel = selectByVar.get("qbt_build_tool");
				if (cur.startsWith("v5.")) {
					if (verSel) verSel.value = "5";
					if (toolSel) toolSel.value = "qmake";
				} else if (cur.startsWith("v6.")) {
					if (verSel) verSel.value = "6";
					if (toolSel) toolSel.value = "cmake";
				}
			}
		}

		function handleDependencies(changed: HTMLSelectElement): void {
			const v = changed.dataset.variable;
			const cur = getSelectValue(changed);

			if (v === "qbt_libtorrent_version") {
				syncLibtorrentSeries(cur);
			}

			if (v === "qbt_libtorrent_tag" && changed.value !== "custom") {
				syncTagSeriesFromValue(v, cur);
			}

			if (v === "qbt_qt_version") {
				const toolSel = selectByVar.get("qbt_build_tool");
				if (toolSel) toolSel.value = cur === "5" ? "qmake" : "cmake";
				syncQtSeries(cur);
			}

			if (v === "qbt_build_tool") {
				const verSel = selectByVar.get("qbt_qt_version");
				const targetQt = cur === "qmake" ? "5" : "6";
				if (verSel && verSel.value !== targetQt) {
					verSel.value = targetQt;
					syncQtSeries(targetQt);
				}
			}

			if (v === "qbt_qt_tag" && changed.value !== "custom") {
				syncTagSeriesFromValue(v, cur);
			}

			if (v === "qbt_docker_user") {
				const volSel = selectByVar.get("qbt_docker_volume");
				const isUser = cur === "username";
				const fromDir = isUser ? ":/root" : ":/home/username";
				const toDir = isUser ? ":/home/username" : ":/root";

				if (volSel) {
					for (const opt of Array.from(volSel.options)) {
						if (opt.value === "custom") continue;
						opt.value = opt.value.replace(fromDir, toDir);
						opt.label = opt.value;
						opt.textContent = opt.value;
					}
					const customVol = getCustomInput("qbt_docker_volume");
					if (customVol?.value) {
						customVol.value = customVol.value.replace(fromDir, toDir);
					}
				}

				for (const snap of Object.values(savedDockerContext)) {
					if (snap.volume && snap.volume !== "custom") {
						snap.volume = snap.volume.replace(fromDir, toDir);
					}
					if (snap.customVolume) {
						snap.customVolume = snap.customVolume.replace(fromDir, toDir);
					}
				}
			}

			if (v === "qbt_cross_name") {
				const staticSel = selectByVar.get("qbt_static_ish");
				if (staticSel) {
					const isCross = cur !== "";
					staticSel.disabled = isCross;
					if (isCross) staticSel.value = "no";
				}
			}

			if (
				v === "qbt_use_lto" ||
				v === "qbt_mcm_url" ||
				v === "qbt_docker_base" ||
				v === "qbt_cross_name"
			) {
				const baseImgSel = selectByVar.get("qbt_docker_base");
				const mcmSel = selectByVar.get("qbt_mcm_url");
				const ltoSel = selectByVar.get("qbt_use_lto");
				const crossSel = selectByVar.get("qbt_cross_name");
				const baseVal = baseImgSel ? getSelectValue(baseImgSel) : "";
				const isDebian =
					baseVal.includes("ubuntu") || baseVal.includes("debian");
				const isCross = (crossSel?.value ?? "") !== "";

				if (v === "qbt_use_lto" && mcmSel && !isDebian && isCross) {
					if (cur === "yes") {
						mcmSel.value = "userdocs/musl-cross-make";
						syncCustomInputUI(mcmSel);
					}
				} else if (v === "qbt_mcm_url" && ltoSel && !isDebian && isCross) {
					if (
						cur !== "userdocs/musl-cross-make" &&
						ltoSel.value === "yes"
					) {
						ltoSel.value = "default";
					}
				} else if (v === "qbt_cross_name" && mcmSel && ltoSel && !isDebian) {
					if (isCross && ltoSel.value === "yes") {
						mcmSel.value = "userdocs/musl-cross-make";
						syncCustomInputUI(mcmSel);
					}
				} else if (v === "qbt_docker_base" && mcmSel && ltoSel) {
					if (isDebian && mcmSel.value === "userdocs/musl-cross-make") {
						mcmSel.value = "userdocs/qbt-musl-cross-make";
						syncCustomInputUI(mcmSel);
					} else if (!isDebian && isCross && ltoSel.value === "yes") {
						mcmSel.value = "userdocs/musl-cross-make";
						syncCustomInputUI(mcmSel);
					}
				}
			}
		}

		function switchPortContext(nextCtx: "docker" | "dockerfile"): void {
			if (!portSelect || nextCtx === activePortContext) return;

			const portCustom = getCustomInput("qbt_docker_port");
			const volSelect = selectByVar.get("qbt_docker_volume");
			const volCustom = getCustomInput("qbt_docker_volume");

			// Snapshot outgoing context
			savedDockerContext[activePortContext] = {
				port: portSelect.value,
				customPort: portCustom?.value ?? "",
				volume: volSelect?.value ?? "",
				customVolume: volCustom?.value ?? "",
			};

			activePortContext = nextCtx;
			const incoming = savedDockerContext[nextCtx];

			if (nextCtx === "dockerfile") {
				portSelect.innerHTML = `
					<option value="8080">8080 (Default)</option>
					<option value="8081">8081</option>
					<option value="9090">9090</option>
					<option value="custom">Custom...</option>
				`;
				portSelect.dataset.default = "8080";
				portSelect.dataset.defaultExample = "8080";
				if (portCustom) {
					portCustom.placeholder = "Enter container port (e.g., 3000)";
				}
				if (portLabelEl) portLabelEl.textContent = "Container Port";

				if (
					incoming.port &&
					portSelect.querySelector(
						`option[value="${CSS.escape(incoming.port)}"]`,
					)
				) {
					portSelect.value = incoming.port;
					if (portCustom) {
						portCustom.value =
							incoming.port === "custom" ? incoming.customPort : "";
					}
				} else {
					const rawDockerPort =
						savedDockerContext.docker.port === "custom"
							? savedDockerContext.docker.customPort
							: savedDockerContext.docker.port;
					const containerPort = rawDockerPort.includes(":")
						? (rawDockerPort.split(":").pop()?.trim() ?? "8080")
						: rawDockerPort.trim() || "8080";

					if (
						portSelect.querySelector(
							`option[value="${CSS.escape(containerPort)}"]`,
						)
					) {
						portSelect.value = containerPort;
						if (portCustom) portCustom.value = "";
					} else {
						portSelect.value = "custom";
						if (portCustom) portCustom.value = containerPort;
					}
				}
			} else {
				portSelect.innerHTML = originalPortOptionsHTML;
				portSelect.dataset.default = originalPortDefault;
				portSelect.dataset.defaultExample = originalPortExample;
				if (portCustom) {
					portCustom.placeholder = "Enter custom docker port mapping";
				}
				if (portLabelEl) portLabelEl.textContent = originalPortLabel;

				if (
					incoming.port &&
					portSelect.querySelector(
						`option[value="${CSS.escape(incoming.port)}"]`,
					)
				) {
					portSelect.value = incoming.port;
				} else {
					portSelect.value = originalPortDefault;
				}
				if (portCustom) {
					portCustom.value =
						portSelect.value === "custom" ? incoming.customPort : "";
				}
			}

			syncCustomInputUI(portSelect);

			if (
				volSelect &&
				incoming.volume &&
				volSelect.querySelector(
					`option[value="${CSS.escape(incoming.volume)}"]`,
				)
			) {
				volSelect.value = incoming.volume;
				if (volCustom) {
					volCustom.value =
						incoming.volume === "custom" ? incoming.customVolume : "";
				}
				syncCustomInputUI(volSelect);
			}
		}

		function classifyTab(tabText: string): TabContext {
			const lower = tabText.trim().toLowerCase();
			if (lower.includes("dockerfile")) return "dockerfile";
			if (lower.includes("docker")) return "docker";
			return "native";
		}

		function syncActiveTab(): void {
			if (!outputSection) return;
			const activeTab = outputSection.querySelector<HTMLElement>(
				'[role="tab"][aria-selected="true"]',
			);
			const tabCtx = classifyTab(activeTab?.textContent ?? "");

			container.dataset.dockerTab =
				tabCtx === "docker" || tabCtx === "dockerfile" ? "true" : "false";
			container.dataset.dockerfileTab =
				tabCtx === "dockerfile" ? "true" : "false";

			if (tabCtx === "dockerfile") {
				switchPortContext("dockerfile");
			} else if (tabCtx === "docker") {
				switchPortContext("docker");
			}

			updateOutputs();
			updateStatusIndicators();
		}

		// ─── Event listeners ──────────────────────────────────────────────────────

		for (const select of selects) {
			select.addEventListener("change", () => {
				syncCustomInputUI(select, { focus: true });
				handleDependencies(select);
				updateOutputs();
				updateStatusIndicators();
			});

			const variable = select.dataset.variable;
			const customInput = variable ? getCustomInput(variable) : null;
			customInput?.addEventListener("input", () => {
				if (variable) {
					syncTagSeriesFromValue(variable, customInput.value.trim());
				}
				updateOutputs();
				updateStatusIndicators();
			});
		}

		// View toggle (Basic / Expert)
		const savedView = readStorage(VIEW_STORAGE_KEY) ?? "basic";
		container.dataset.view = savedView === "advanced" ? "advanced" : "basic";
		if (viewToggle) {
			viewToggle.checked = container.dataset.view === "advanced";
			viewToggle.addEventListener("change", () => {
				const view = viewToggle.checked ? "advanced" : "basic";
				container.dataset.view = view;
				writeStorage(VIEW_STORAGE_KEY, view);
				updateStatusIndicators();
			});
		}

		// Reset
		resetButton?.addEventListener("click", () => {
			container.dataset.view = "basic";
			if (viewToggle) {
				viewToggle.checked = false;
				writeStorage(VIEW_STORAGE_KEY, "basic");
			}

			savedDockerContext.docker = {
				port: "",
				customPort: "",
				volume: "",
				customVolume: "",
			};
			savedDockerContext.dockerfile = {
				port: "",
				customPort: "",
				volume: "",
				customVolume: "",
			};

			// Restore canonical Docker port options before applying tab context
			if (portSelect && activePortContext === "dockerfile") {
				portSelect.innerHTML = originalPortOptionsHTML;
				portSelect.dataset.default = originalPortDefault;
				portSelect.dataset.defaultExample = originalPortExample;
				if (portLabelEl) portLabelEl.textContent = originalPortLabel;
				activePortContext = "docker";
			}

			for (const select of selects) {
				const variable = select.dataset.variable;
				if (variable === "qbt_docker_volume") {
					for (const opt of Array.from(select.options)) {
						if (opt.value === "custom") continue;
						opt.value = opt.value.replace(":/home/username", ":/root");
						opt.label = opt.value;
						opt.textContent = opt.value;
					}
				}

				select.value = select.dataset.default ?? "";
				select.disabled = false;
				syncCustomInputUI(select);
			}

			syncLibtorrentSeries("2.1");
			syncQtSeries("6");
			syncActiveTab();
		});

		// Copy buttons
		for (const btn of container.querySelectorAll<HTMLButtonElement>(
			".copy-button[data-output]",
		)) {
			btn.addEventListener("click", async () => {
				const key = btn.dataset.output ?? "";
				const text = latestOutputs[key] ?? "";
				try {
					await navigator.clipboard.writeText(text);
					btn.textContent = "Copied!";
				} catch {
					btn.textContent = "Failed";
				}
				const prevTimer = copyTimers.get(btn);
				if (prevTimer !== undefined) window.clearTimeout(prevTimer);
				const nextTimer = window.setTimeout(() => {
					btn.textContent = "Copy";
					copyTimers.delete(btn);
				}, 2000);
				copyTimers.set(btn, nextTimer);
			});
		}

		// Download buttons (Dockerfile & .qbt_env)
		for (const btn of container.querySelectorAll<HTMLButtonElement>(
			".download-button[data-output]",
		)) {
			btn.addEventListener("click", () => {
				const key = btn.dataset.output ?? "";
				const filename = btn.dataset.filename ?? "config.txt";
				const text = latestOutputs[key] ?? "";
				const blob = new Blob([text + "\n"], {
					type: "text/plain;charset=utf-8",
				});
				const url = URL.createObjectURL(blob);
				const link = document.createElement("a");
				link.href = url;
				link.download = filename;
				document.body.appendChild(link);
				link.click();
				link.remove();
				URL.revokeObjectURL(url);
			});
		}

		// Output tab observation (handles click, keyboard navigation, and Starlight syncKey)
		if (outputSection) {
			new MutationObserver((mutations) => {
				if (
					mutations.some(
						(m) =>
							m.type === "attributes" &&
							(m.target as HTMLElement).getAttribute("role") === "tab",
					)
				) {
					syncActiveTab();
				}
			}).observe(outputSection, {
				attributes: true,
				attributeFilter: ["aria-selected"],
				subtree: true,
			});
		}

		syncActiveTab();
	}

	function initAllBuildConfigs(): void {
		for (const el of document.querySelectorAll<HTMLElement>(
			"[data-build-config]",
		)) {
			initBuildConfigInstance(el);
		}
	}

	initAllBuildConfigs();
	document.addEventListener("astro:page-load", initAllBuildConfigs);
</script>
